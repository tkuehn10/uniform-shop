# Copy this file to .env and fill in the values from your Supabase project:
# Project Settings -> API Keys. Never commit the real .env file.
#
# VITE_SUPABASE_URL is the "Project URL" on that page.
#
# VITE_SUPABASE_ANON_KEY: Supabase is in the middle of renaming this key
# (rolling out through 2026) from "anon" / "anon public" to "Publishable key"
# (starts with sb_publishable_...). Whichever label your project shows,
# paste that value here -- both work identically with this app's code.
# Do NOT use the "service_role" / "secret" key here -- that one must never
# go into a frontend .env or be shipped to the browser.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-or-publishable-key

# Displayed on the login screen and in the app's top nav bar. Not sensitive --
# just a display string. Falls back to "Uniform Shop" if unset.
VITE_SHOP_NAME=Your Uniform Shop Name
